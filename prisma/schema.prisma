// Snigdha — Prisma schema
// PostgreSQL via driver adapter (@prisma/adapter-pg). URL configured in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  SSL_COMMERZ
  STRIPE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum InventoryChangeReason {
  RESTOCK
  ADJUSTMENT
  ORDER
  RETURN
}

enum PageType {
  TEXT
  LANDING
}

enum IncompleteOrderStatus {
  OPEN
  CONVERTED
  DISMISSED
}

model ShippingZone {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  divisions             String[]
  matchesAll            Boolean  @default(false)
  standardFee           Int      @default(60)
  expressFee            Int      @default(120)
  freeShippingThreshold Int?
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType])
  @@index([actorId])
}

// ---------------------------------------------------------------- auth

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  verificationTokens VerificationToken[]
  addresses          Address[]
  carts              Cart[]
  wishlist           WishlistItem[]
  orders             Order[]
  reviews            Review[]
  auditLogs          AuditLog[]
  incompleteOrders   IncompleteOrder[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      String // "EMAIL_VERIFICATION" | "PASSWORD_RESET"
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- catalogue

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  price            Int // taka, integer cents-free units
  compareAtPrice   Int?
  costPrice        Int?
  sku              String        @unique
  stock            Int           @default(0)
  categoryId       String?
  brand            String?
  featured         Boolean       @default(false)
  published        Boolean       @default(true)
  status           ProductStatus @default(ACTIVE)
  seoTitle         String?
  seoDescription   String?
  soldCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                ProductImage[]
  variants              ProductVariant[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([slug])
  @@index([published, status])
  @@index([featured])
  @@index([createdAt])
  @@index([soldCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String // e.g. "Size S", "Color — Navy"
  sku        String   @unique
  price      Int?
  stock      Int      @default(0)
  attributes Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([productId])
  @@index([sku])
}

// ---------------------------------------------------------------- commerce

model Address {
  id          String   @id @default(cuid())
  userId      String
  name        String
  phone       String
  division    String
  district    String
  area        String
  addressLine String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id             String    @id @default(cuid())
  userId         String?
  sessionId      String?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId, sessionId])
  @@index([sessionId])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int      @default(1)
  price         Int // snapshot at add time (server-validated)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod
  subtotal        Int
  discount        Int           @default(0)
  deliveryFee     Int           @default(0)
  total           Int
  couponCode      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress Json
notes          String?
  internalNote   String?
  /// Deterministic CAPI/Pixel event ID, persisted at first send so every retry
  /// reuses the same value and Meta can deduplicate against the browser event.
  metaPurchaseEventId     String?   @unique
  metaPurchaseSent        Boolean   @default(false)
  metaPurchaseSentAt      DateTime?
  metaPurchaseError       String?
  metaPurchaseAttempts    Int       @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  timeline        OrderTimelineEvent[]
  incompleteOrder IncompleteOrder?

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  sku         String
  quantity    Int
  price       Int
  total       Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderTimelineEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

/// A checkout a customer started (name + phone captured) but never submitted.
/// This is NOT an Order: it has no order number, holds no stock, and only
/// becomes revenue when staff converts it into a real Order.
model IncompleteOrder {
  id               String                @id @default(cuid())
  cartId           String                @unique
  userId           String?
  status           IncompleteOrderStatus @default(OPEN)
  stage            String                @default("CONTACT") // CONTACT | DETAILS
  customerName     String
  customerPhone    String
  customerEmail    String?
  addressLine      String?
  deliveryZone     String?
  items            Json
  itemCount        Int                   @default(0)
  subtotal         Int
  discount         Int                   @default(0)
  couponCode       String?
  deliveryFee      Int                   @default(0)
  total            Int
  internalNote     String?
  convertedOrderId String?               @unique
  convertedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user           User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  convertedOrder Order? @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([customerPhone])
  @@index([userId])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Int // percentage (0-100) or fixed taka
  minimumOrder    Int        @default(0)
  maximumDiscount Int?
  usageLimit      Int?
  usedCount       Int        @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([code])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  orderId    String?
  rating     Int
  title      String?
  comment    String
  image      String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, isApproved])
  @@index([userId])
}

// ---------------------------------------------------------------- operations

model InventoryTransaction {
  id             String                @id @default(cuid())
  productId      String
  variantId      String?
  quantityChange Int // positive or negative
  reason         InventoryChangeReason
  note           String?
  createdAt      DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  type      PageType @default(TEXT)
  content   String   @default("")
  html      String?
  css       String?
  js        String?
  /// Opt-in Tailwind Play CDN for LANDING pages, so author markup can use
  /// utility classes that the compiled stylesheet does not contain.
  useTailwindCdn Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
